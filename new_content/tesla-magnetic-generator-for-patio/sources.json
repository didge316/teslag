          "text": "كيفية عمل هذا المولد"
        },
        {
          "timestamp": "0:00",
          "text": "ذي الأقطاب الكثيرة."
        },
        {
          "timestamp": "0:00",
          "text": "أولاً، لدينا الإطار"
        },
        {
          "timestamp": "0:00",
          "text": "المغناطيسي الرئيسي،"
        },
        {
          "timestamp": "0:00",
          "text": "ويسمى الإطار الحلقي،"
        },
        {
          "timestamp": "0:00",
          "text": "وهو على شكل حلقة. يتم"
        },
        {
          "timestamp": "0:00",
          "text": "دعمه بواسطة حوامل"
        },
        {
          "timestamp": "0:00",
          "text": "ويرتكز على قاعدة."
        },
        {
          "timestamp": "0:00",
          "text": "داخل هذه الحلقة، توجد"
        },
        {
          "timestamp": "0:00",
          "text": "العديد من الأقطاب"
        },
        {
          "timestamp": "0:00",
          "text": "المغناطيسية الصغيرة"
        },
        {
          "timestamp": "0:00",
          "text": "الناتجة عن أخاديد"
        },
        {
          "timestamp": "0:00",
          "text": "محفورة في الإطار."
        },
        {
          "timestamp": "0:00",
          "text": "لتنشيط هذه الأقطاب،"
        },
        {
          "timestamp": "0:00",
          "text": "نقوم بلف سلك معزول"
        },
        {
          "timestamp": "0:00",
          "text": "بنمط متعرج عبر"
        },
        {
          "timestamp": "0:00",
          "text": "الأخاديد حول الحلقة."
        },
        {
          "timestamp": "0:00",
          "text": "وهذا يخلق مجالات"
        },
        {
          "timestamp": "0:00",
          "text": "مغناطيسية متناوبة."
        },
        {
          "timestamp": "0:00",
          "text": "تصبح بعض الأقطاب"
        },
        {
          "timestamp": "0:00",
          "text": "شمالية، بينما تصبح"
        },
        {
          "timestamp": "0:00",
          "text": "الأخرى جنوبية، على"
        },
        {
          "timestamp": "0:00",
          "text": "طول محيط الحلقة"
        },
        {
          "timestamp": "0:00",
          "text": "بالكامل. التالي هو"
        },
        {
          "timestamp": "0:00",
          "text": "العضو الدوار، وهو"
        },
        {
          "timestamp": "0:00",
          "text": "الجزء الذي يدور. يتم"
        },
        {
          "timestamp": "0:00",
          "text": "تثبيته على عمود مدعوم"
        },
        {
          "timestamp": "0:00",
          "text": "بمحامل. يحمل العضو"
        },
        {
          "timestamp": "0:00",
          "text": "الدوار إطاراً"
        },
        {
          "timestamp": "0:00",
          "text": "دائرياً بقلب مصنوع من"
        },
        {
          "timestamp": "0:00",
          "text": "أسلاك حديدية دقيقة."
        },
        {
          "timestamp": "0:00",
          "text": "هذا القلب هو المكان"
        },
        {
          "timestamp": "0:00",
          "text": "الذي نلف فيه ملفات"
        },
        {
          "timestamp": "0:00",
          "text": "العضو الدوار، والتي"
        },
        {
          "timestamp": "0:00",
          "text": "يتم توصيلها بعد ذلك"
        },
        {
          "timestamp": "0:00",
          "text": "على التوالي. عندما"
        },
        {
          "timestamp": "0:00",
          "text": "تعمل الآلة، تتفاعل"
        },
        {
          "timestamp": "0:00",
          "text": "المجالات المغناطيسية"
        },
        {
          "timestamp": "0:00",
          "text": "من الأقطاب مع العضو"
        },
        {
          "timestamp": "0:00",
          "text": "الدوار، مما يولد"
        },
        {
          "timestamp": "0:00",
          "text": "تياراً متناوباً. يتم"
        },
        {
          "timestamp": "0:00",
          "text": "تجميع التيار من خلال"
        },
        {
          "timestamp": "0:00",
          "text": "فرش وحلقات تلامس"
        },
        {
          "timestamp": "0:00",
          "text": "متصلة بالعمود. يسمح"
        },
        {
          "timestamp": "0:00",
          "text": "هذا التصميم بوجود آلة"
        },
        {
          "timestamp": "0:00",
          "text": "بها مئات الأقطاب"
        },
        {
          "timestamp": "0:00",
          "text": "المغناطيسية، وبسرعات"
        },
        {
          "timestamp": "0:00",
          "text": "تتراوح بين 1500 و 1600"
        },
        {
          "timestamp": "0:00",
          "text": "دورة في الدقيقة،"
        },
        {
          "timestamp": "0:00",
          "text": "يمكنها توليد ما يصل"
        },
        {
          "timestamp": "0:00",
          "text": "إلى 11,000 تيار متناوب"
        },
        {
          "timestamp": "0:00",
          "text": "في الثانية، وهو أمر"
        },
        {
          "timestamp": "0:00",
          "text": "مثالي للتطبيقات"
        },
        {
          "timestamp": "0:00",
          "text": "عالية التردد. بهذه"
        },
        {
          "timestamp": "0:00",
          "text": "الطريقة، صمم نيكولا"
        },
        {
          "timestamp": "0:00",
          "text": "تسلا مولد التيار"
        },
        {
          "timestamp": "0:00",
          "text": "المتناوب عالي التردد"
        },
        {
          "timestamp": "0:00",
          "text": "الخاص به. ميزة أخرى"
        },
        {
          "timestamp": "0:00",
          "text": "لاستخدام هذا المولد"
        },
        {
          "timestamp": "0:00",
          "text": "عالي التردد هي أنه"
        },
        {
          "timestamp": "0:00",
          "text": "يجعل القوس يتصرف كما"
        },
        {
          "timestamp": "0:00",
          "text": "لو كان ناتجاً عن تيار"
        },
        {
          "timestamp": "0:00",
          "text": "مستمر. يحدث هذا لأن"
        },
        {
          "timestamp": "0:00",
          "text": "النبضات السريعة"
        },
        {
          "timestamp": "0:00",
          "text": "والمتكررة تبقي الغاز"
        },
        {
          "timestamp": "0:00",
          "text": "ساخنًا، مما يمنعه من"
        },
        {
          "timestamp": "0:00",
          "text": "البرودة بشكل مفرط."
        },
        {
          "timestamp": "0:00",
          "text": "ونتيجة لذلك، يظل"
        },
        {
          "timestamp": "0:00",
          "text": "القوس ثابتًا ولا يفقد"
        },
        {
          "timestamp": "0:00",
          "text": "قوته. قد يبدو ضجيج"
        },
        {
          "timestamp": "0:00",
          "text": "مصابيح القوس مشكلة"
        },
        {
          "timestamp": "0:00",
          "text": "بسيطة اليوم، لكن حل"
        },
        {
          "timestamp": "0:00",
          "text": "تسلا كان نقطة تحول في"
        },
        {
          "timestamp": "0:00",
          "text": "مسيرة العالم"
        },
        {
          "timestamp": "0:00",
          "text": "الكهربائي الحديث"
        },
        {
          "timestamp": "0:00",
          "text": "الذي نعيش فيه الآن. إن"
        },
        {
          "timestamp": "0:00",
          "text": "عمل نيكولا تسلا على"
        },
        {
          "timestamp": "0:00",
          "text": "مصابيح القوس ليس سوى"
        },
        {
          "timestamp": "0:00",
          "text": "فصل واحد من قصته"
        },
        {
          "timestamp": "0:00",
          "text": "المذهلة، وهي قصة شكلت"
        },
        {
          "timestamp": "0:00",
          "text": "العالم الذي نعيشه"
        },
        {
          "timestamp": "0:00",
          "text": "اليوم. تجاوزت مساهمات"
        },
        {
          "timestamp": "0:00",
          "text": "تسلا مجرد الإضاءة"
        },
        {
          "timestamp": "0:00",
          "text": "الصامتة. لقد لمست"
        },
        {
          "timestamp": "0:00",
          "text": "عبقريته كل شيء بدءًا"
        },
        {
          "timestamp": "0:00",
          "text": "من التيار المتردد"
        },
        {
          "timestamp": "0:00",
          "text": "وصولاً إلى الاتصالات"
        },
        {
          "timestamp": "0:00",
          "text": "اللاسلكية، مما عزز"
        },
        {
          "timestamp": "0:00",
          "text": "دوره كواحد من أعظم"
        },
        {
          "timestamp": "0:00",
          "text": "المخترعين في التاريخ."
        },
        {
          "timestamp": "0:00",
          "text": "هناك العديد من"
        },
        {
          "timestamp": "0:00",
          "text": "الابتكارات المذهلة"
        },
        {
          "timestamp": "0:00",
          "text": "الأخرى التي قدمها"
        },
        {
          "timestamp": "0:00",
          "text": "تسلا. بينما نتجه نحو"
        },
        {
          "timestamp": "0:00",
          "text": "مستقبل يعمل بالطاقة"
        },
        {
          "timestamp": "0:00",
          "text": "المتجددة، نواصل"
        },
        {
          "timestamp": "0:00",
          "text": "الوقوف على أكتاف"
        },
        {
          "timestamp": "0:00",
          "text": "عمالقة مثل تسلا،"
        },
        {
          "timestamp": "0:00",
          "text": "الذين تستمر"
        },
        {
          "timestamp": "0:00",
          "text": "مساهماتهم في إنارة"
        },
        {
          "timestamp": "0:00",
          "text": "الطريق نحو المستقبل."
        },
        {
          "timestamp": "0:00",
          "text": "إذا استمتعت بهذا"
        },
        {
          "timestamp": "0:00",
          "text": "الاستكشاف لعبقرية"
        },
        {
          "timestamp": "0:00",
          "text": "تسلا، تأكد من الإعجاب"
        },
        {
          "timestamp": "0:00",
          "text": "بالفيديو، والاشتراك"
        },
        {
          "timestamp": "0:00",
          "text": "للمزيد من المحتوى حول"
        },
        {
          "timestamp": "0:00",
          "text": "الاختراعات الرائدة،"
        },
        {
          "timestamp": "0:00",
          "text": "وتفعيل جرس التنبيهات"
        },
        {
          "timestamp": "0:00",
          "text": "للبقاء على اطلاع."
        },
        {
          "timestamp": "0:00",
          "text": "للمزيد من الفيديوهات"
        },
        {
          "timestamp": "0:00",
          "text": "حول اختراعات نيكولا"
        },
        {
          "timestamp": "0:00",
          "text": "تسلا، تفضل بزيارة"
        },
        {
          "timestamp": "0:00",
          "text": "قناتي."
        }
      ],
      "hasTranscript": true
    }
  ]
}
